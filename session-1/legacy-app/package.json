{
  "name": "bugbase",
  "version": "1.2.3",
  "description": "BugBase - Issue Tracking System",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "start:dev": "nodemon src/server.js",
    "build": "tsc",
    "seed": "ts-node src/seed.ts",
    "test": "jest --verbose",
    "build:client": "webpack --config client/webpack.config.js --mode production",
    "dev:client": "webpack serve --config client/webpack.config.js --mode development"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "body-parser": "^1.19.0",
    "cors": "^2.8.5",
    "dotenv": "^8.2.0",
    "express": "^4.21.0",
    "jsonwebtoken": "^8.5.1",
    "lodash": "^4.17.15",
    "marked": "^0.7.0",
    "moment": "^2.29.1",
    "morgan": "^1.10.0",
    "node-fetch": "^2.6.1",
    "uuid": "^3.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "babel-loader": "^9.1.0",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.7.0",
    "css-minimizer-webpack-plugin": "^5.0.0",
    "csv-loader": "^3.0.5",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.5.0",
    "jest": "^29.7.0",
    "mini-css-extract-plugin": "^2.7.0",
    "nodemon": "^3.0.0",
    "sass": "^1.57.0",
    "sass-loader": "^13.2.0",
    "style-loader": "^3.3.0",
    "supertest": "^6.3.0",
    "terser-webpack-plugin": "^5.3.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0",
    "webpack": "^5.75.0",
    "webpack-bundle-analyzer": "^4.7.0",
    "webpack-cli": "^5.0.0",
    "webpack-dev-server": "^4.11.0"
  },
  "jest": {
    "transform": {
      "^.+\\.tsx?$": "ts-jest",
      "^.+\\.jsx?$": "babel-jest"
    },
    "transformIgnorePatterns": [
      "node_modules/"
    ],
    "testEnvironment": "node"
  }
}
